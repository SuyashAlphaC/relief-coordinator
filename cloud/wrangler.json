{
  "name": "relief-desk-cloud",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "site-creator-d1",
      "database_id": "00000000-0000-4000-8000-000000000000"
    }
  ],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "relief-desk-attachments" }
  ],
  "queues": {
    "producers": [{ "binding": "EVENTS", "queue": "relief-desk-events" }],
    "consumers": [
      {
        "queue": "relief-desk-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "relief-desk-events-dlq"
      }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "CoordinationRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CoordinationRoom"] }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true }
}
